[0m12:09:52.580375 [debug] [Thread-1 (]: On model.pricescope.dim_product: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "pricescope", "target_name": "dev", "node_id": "model.pricescope.dim_product"} */

  
    

  create  table
    "dev"."marts"."dim_product__dbt_tmp"
    
    diststyle all
    
  as (
    

--product_details : one row per product

WITH ranked AS (
    SELECT 
        product_id,
        product_name,
        brand,
        category,
        product_url,
        scraped_at,
        row_number() OVER (PARTITION BY product_id ORDER BY scraped_at DESC) AS rn   --if any product details are modified, we will pull the latest one using scraped_at.
    FROM "dev"."marts_staging"."stg_smartprix_prices"
),

latest_per_product AS (
    SELECT
        product_id AS product_key,
        product_name,
        brand,
        category,
        product_url
    FROM ranked WHERE rn=1
)

SELECT * FROM latest_per_product ORDER BY product_key
  );
